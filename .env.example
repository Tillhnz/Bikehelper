# Kopiere diese Datei nach .env und passe die Werte an.

# Beliebiges, langes Passwort für die Datenbank
POSTGRES_PASSWORD=bitte-aendern

# Zufälliger Schlüssel für Login-Tokens, erzeugen z. B. mit: openssl rand -hex 32
SECRET_KEY=bitte-aendern

# Die spätere öffentliche Adresse (wird für Strava-Callback benötigt)
PUBLIC_URL=http://localhost:8080

# Darf sich jeder registrieren? false = nur du (das erste Konto) und Leute mit Einladungscode.
# Einladungen erzeugst du als Administrator unter Einstellungen -> Einladungen.
ALLOW_REGISTRATION=false

# Wie viele Proxys stehen vor dem Webserver (Nginx Proxy Manager = 1)? Wichtig für die Login-Drosselung.
TRUSTED_PROXIES=1

# Wie lange ein Login gilt (Tage)
TOKEN_EXPIRE_DAYS=7

# Port, auf dem das Frontend im Heimnetz erreichbar ist (Ziel für den Nginx Proxy Manager)
WEB_PORT=8080

# Wetter pro Fahrt von Open-Meteo holen (sendet gerundete Startkoordinaten dorthin)
WEATHER_ENABLED=true

# Zeitzone für Statistiken (Wochentage, Startzeiten, Kalender)
TIMEZONE=Europe/Berlin

# Karten: CARTO verlangt für die dunkle Karte einen kostenlosen Schlüssel (https://carto.com/basemaps/apikey/).
# Leer lassen = helle OpenStreetMap-Karte. Alternativ MAP_TILE_URL mit eigener Kachel-URL ({z}/{x}/{y}).
CARTO_API_KEY=
MAP_TILE_URL=
MAP_TILE_DARK=true

# Erinnerungen, wenn eine Wartung bald oder fällig ist. ntfy (Push aufs Handy) braucht nur ein Thema in den Einstellungen.
# E-Mail braucht einen SMTP-Server (z. B. dein Mail-Anbieter). Leer lassen = keine E-Mails.
REMINDERS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true = Verbindung mit STARTTLS verschlüsseln (Port 587). Bei Port 465 wird automatisch von Anfang an verschlüsselt.
SMTP_STARTTLS=true
NTFY_SERVER=https://ntfy.sh

# Städte und Länder in der Statistik: BikeHelper schlägt Orte einmalig bei OpenStreetMap (Nominatim) nach und speichert sie.
# Gesendet werden nur die Mittelpunkte einzelner Kacheln. Mit false ausschalten oder NOMINATIM_URL auf einen eigenen Server setzen.
GEO_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Wahoo-Import ein- oder ausschalten (jeder Nutzer verbindet sein Konto selbst in den Einstellungen)
WAHOO_ENABLED=true
