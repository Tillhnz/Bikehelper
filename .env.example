# Kopiere diese Datei nach .env und passe die Werte an.

# Beliebiges, langes Passwort für die Datenbank
POSTGRES_PASSWORD=bitte-aendern

# Zufälliger Schlüssel für Login-Tokens, erzeugen z. B. mit: openssl rand -hex 32
SECRET_KEY=bitte-aendern

# Die spätere öffentliche Adresse (wird für Strava-Callback benötigt)
PUBLIC_URL=http://localhost:8080

# Neue Registrierungen erlauben? Nach Anlegen deines Accounts auf false setzen,
# solange nur du (und eingeladene Freunde) die Seite nutzen sollt.
ALLOW_REGISTRATION=true

# Port, auf dem das Frontend im Heimnetz erreichbar ist (Ziel für den Nginx Proxy Manager)
WEB_PORT=8080

# Wetter pro Fahrt von Open-Meteo holen (sendet gerundete Startkoordinaten dorthin)
WEATHER_ENABLED=true

# Zeitzone für Statistiken (Wochentage, Startzeiten, Kalender)
TIMEZONE=Europe/Berlin

# Karten: CARTO verlangt für die dunkle Karte einen kostenlosen Schlüssel (https://carto.com/basemaps/apikey/).
# Leer lassen = helle OpenStreetMap-Karte. Alternativ MAP_TILE_URL mit eigener Kachel-URL ({z}/{x}/{y}).
CARTO_API_KEY=
MAP_TILE_URL=
MAP_TILE_DARK=true
